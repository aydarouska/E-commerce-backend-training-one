# انسخ الملف ده باسم .env و املى القيم بتاعتك (ملف .env سرى و مايترفعش على GitHub)

# ---------- السيرفر ----------
PORT=5000
NODE_ENV=development

# رابط الفرونت اند (بالمسار بتاع vite). بيستخدم لـ CORS و للصفحه اللى Paymob يرجع العميل ليها بعد الدفع
# ممكن تكتب اكتر من رابط بينهم فاصله
CLIENT_URL=http://localhost:5173/E-commerce-training-one

# رابط الباك اند العام. Paymob بيبعت عليه نتيجه الدفع (webhook)
# على جهازك (localhost) الـ webhook مش هيشتغل و ده عادى - السيرفر بيتأكد من صفحه الرجوع بدله
# بعد الرفع على سيرفر حقيقى اكتب الرابط الحقيقى زى https://api.mystore.com
SERVER_PUBLIC_URL=http://localhost:5000

# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecommerce

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# ---------- Paymob (مصر) ----------
# من لوحه تحكم Paymob > Settings > Account Info: المفتاح السرى و العام و HMAC
# من Developers > Payment Integrations: رقم الـ integration للكارت و للمحافظ (فودافون كاش)
# استخدم مفاتيح Test الاول و بعد ما تجرب حط مفاتيح Live
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_API_BASE=https://accept.paymob.com
PAYMOB_CHECKOUT_BASE=https://eg.checkout.paymob.com

# ---------- تأكيد الحساب (تم الاضافه) ----------
# لو سبت الخانات دى فاضيه: كود التأكيد بيتطبع فى التيرمنال بتاع الباك اند (وقت التجربه)
# الايميل (مثال Gmail - محتاج "App Password" من اعدادات حساب جوجل > الامان)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# رسايل الموبايل SMS (من لوحه تحكم Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# وضع العرض التجريبى: true = الكود بيظهر على الشاشه لو الارسال الحقيقى مش متظبط
# مفيد عشان تجرب الموقع اونلاين - اقفله (امسح السطر) اول ما الموقع يشتغل بجد مع عملاء
SHOW_DEV_CODES=true
